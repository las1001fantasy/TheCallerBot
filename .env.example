# Token de BotFather (no lo subas nunca a un repositorio)
TELEGRAM_BOT_TOKEN=
# Cada cuántos segundos se revisan los drafts (300 = 5 minutos)
CHECK_INTERVAL=300
# Ruta de la base de datos
